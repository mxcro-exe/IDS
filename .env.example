# ==============================================================================
# AI-Powered API Gateway IDS - Environment Configuration
# ==============================================================================

# Server Network Settings
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
TARGET_API_URL=http://127.0.0.1:8000/demo

# Operating Mode: protect (strict blocking), monitor (warn only), learning (log only)
OPERATION_MODE=protect

# Multi-Factor Risk Weights (w1 + w2 + w3 = 1.0)
WEIGHT_ML=0.45
WEIGHT_BEHAVIORAL=0.35
WEIGHT_RULES=0.20

# Decision Thresholds
WARN_THRESHOLD=0.40
BLOCK_THRESHOLD=0.70

# Rate Limiter Configurations
RATE_LIMIT_MAX_REQUESTS=50
RATE_LIMIT_WINDOW_SECONDS=60

# Decoy Honeypot Auto-Ban Duration (Minutes)
AUTOBAN_MINUTES=10

# Optional Alert Notifications (Leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENT=

# AegisGate Copilot - Cloud AI Fallback (Gemini API)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=12.0
